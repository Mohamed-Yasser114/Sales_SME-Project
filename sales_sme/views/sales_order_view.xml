<odoo>
    <record id="sales_order_view_list" model="ir.ui.view">
        <field name="name">sales.order.list</field>
        <field name="model">sales.order</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="customer_id"/>
                <field name="date_order"/>
                <field name="state"/>
                <field name="total_amount" readonly="1"/>
            </list>
        </field>
    </record>
    <record id="sales_order_view_form" model="ir.ui.view">
        <field name="name">sales.order.form</field>
        <field name="model">sales.order</field>
        <field name="arch" type="xml">
            <form string="Sales Order">
                <header>
                    <button name="action_draft" type="object" string="Reset to draft" class="btn-secondary" invisible="state!='cancel'"/>
                    <button name="action_confirm" type="object" string="Confirm" class="btn-primary oe_highlight" invisible="state!='draft'"/>
                    <button name="action_done" type="object" string="Done" class="btn-success" invisible="state!='confirmed'"/>
                    <button name="action_cancel" type="object" string="Cancel" class="btn-danger oe_highlight" invisible="state!='confirmed'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,done,cancel" readonly="1"/>
                </header>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="customer_id" readonly="state!='draft'"/>
                        <field name="date_order" readonly="state!='draft'"/>
                        <field name="state"/>
                        <field name="total_amount" readonly="1"/>
                        <field name="total_amount_new" readonly="1"/>
                    </group>
                    <notebook>
                        <page string="Order Lines">
                            <field name="order_line">
                                <list editable="bottom">
                                    <field name="product_id" readonly="parent.state!='draft'"/>
                                    <field name="quantity" readonly="parent.state!='draft'"/>
                                    <field name="price_unit" readonly="parent.state!='draft'"/>
                                    <field name="subtotal" readonly="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
    <record id="sales_order_view_search" model="ir.ui.view">
        <field name="name">sales.order.search</field>
        <field name="model">sales.order</field>
        <field name="arch" type="xml">
            <search string="Sales Order Search">
                <field name="name"/>
                <field name="customer_id"/>
                <field name="date_order"/>

                <filter name="draft" string="Draft" domain="[('state','=','draft')]"/>
                <filter name="confirmed" string="Confirmed" domain="[('state','=','confirmed')]"/>
                <filter name="done" string="Done" domain="[('state','=','done')]"/>
                <filter name="canceled" string="Canceled" domain="[('state','=','cancel')]"/>
                <filter name="group_by_customer" string="Group By Customer" context="{'group_by':'customer_id'}"/>
                <filter name="group_by_state" string="Group By State" context="{'group_by':'state'}"/>
            </search>
        </field>
    </record>
    <record id="action_sales_order" model="ir.actions.act_window">
        <field name="name">Sales Orders</field>
        <field name="res_model">sales.order</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="sales_order_root" name="Sales Management"/>
    <menuitem id="sales_order_menu" name="Sales Orders" parent="sales_order_root" action="action_sales_order"/>
</odoo>