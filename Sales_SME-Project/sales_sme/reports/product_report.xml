<odoo>
    <record id="product_report" model="ir.actions.report">
        <field name="name">Product Report</field>
        <field name="model">product.template</field>
        <field name="report_type">qweb-html</field>
        <field name="binding_model_id" ref="product.model_product_template"/>
        <field name="binding_type">report</field>
        <field name="report_name">sales_sme.product_report_template</field>
    </record>
    <template id="product_report_template">
        <t t-call="web.html_container">
            <t t-call="web.internal_layout">
                <style>
                    .page {
                    width: 136mm;
                    height: 148mm;
                    page-break-after: always;
                    }
                    .salesPrice, .cost {
                        display: inline-block;
                        margin-right: 10px;
                    }
                    img {
                        display: block;
                    }
                </style>
                <t t-foreach="docs" t-as="record">
                    <div class="page">
                        <h3 t-field="record.name"/>
                        <p class="ref">
                            <strong>Ref:</strong>
                            <span t-field="record.default_code"/>
                        </p>
                        <p class="salesPrice">
                            <strong>Sales Price:</strong>
                            <span t-field="record.list_price"/>
                        </p>
                        <p class="cost">
                            <strong>Cost:</strong>
                            <span t-field="record.standard_price"/>
                        </p>
                        <t t-if="record.barcode">
                            <img
                                t-att-src="'/report/barcode/Code128/%s' % record.barcode"
                                style="width:200px; height:60px; margin-left: 0;"
                            />
                        </t>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>